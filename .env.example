# Copy to .env.local (git-ignored) and adjust as needed.
# All variables are embedded into the JS bundle at BUILD time - never put secrets here.

# Base URL of the backend REST API, including the /api prefix.
# Default "/api" = same origin (CRA dev proxy in development, nginx in production).
# Set an absolute URL only when the API is on a different domain, e.g. https://api.example.org/api
REACT_APP_API_URL=/api

# Request timeout in milliseconds
REACT_APP_API_TIMEOUT_MS=15000

# Log API calls to the browser console (development builds only)
REACT_APP_DEBUG=false
